{
  "manifest_version": 3,
  "name": "Twimark",
  "version": "0.10.0",
  "description": "X・Instagram・note・Qiita・pixiv・BOOTH・GitHub・unityroom・ふりーむ！の投稿・記事・作品、Google マップの場所、レシピとお店のページと、ほかのページのメモを Twimark に追加します。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Twimarkに追加",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "https://twimark.ho-service.workers.dev/*",
    "https://api.fxtwitter.com/*",
    "https://note.com/*",
    "https://qiita.com/*",
    "https://www.instagram.com/*",
    "https://www.pixiv.net/*",
    "https://booth.pm/*",
    "https://*.booth.pm/*",
    "https://github.com/*",
    "https://unityroom.com/*",
    "https://www.freem.ne.jp/*",
    "https://cookpad.com/*",
    "https://delishkitchen.tv/*",
    "https://www.kurashiru.com/*",
    "https://recipe.rakuten.co.jp/*",
    "https://www.hotpepper.jp/*",
    "https://r.gnavi.co.jp/*",
    "https://www.google.com/maps/*",
    "https://www.google.co.jp/maps/*",
    "https://maps.google.com/*",
    "https://maps.app.goo.gl/*",
    "https://goo.gl/maps/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://mobile.twitter.com/*",
        "https://note.com/*",
        "https://qiita.com/*",
        "https://www.instagram.com/*",
        "https://www.pixiv.net/*",
        "https://booth.pm/*",
        "https://*.booth.pm/*",
        "https://github.com/*",
        "https://unityroom.com/*",
        "https://www.freem.ne.jp/*",
        "https://cookpad.com/*",
        "https://delishkitchen.tv/*",
        "https://www.kurashiru.com/*",
        "https://recipe.rakuten.co.jp/*",
        "https://www.hotpepper.jp/*",
        "https://r.gnavi.co.jp/*",
        "https://www.google.com/maps/*",
        "https://www.google.co.jp/maps/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ]
    },
    {
      "matches": [
        "https://twimark.ho-service.workers.dev/*"
      ],
      "js": [
        "link.js"
      ],
      "run_at": "document_start"
    }
  ]
}
